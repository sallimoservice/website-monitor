# Copy this file to ".env" for testing on your own PC. All values below are FAKE.
# ".env" is ignored by git. On GitHub, put the same names in Settings > Secrets and variables > Actions.

# --- Websites ---------------------------------------------------------------
# On GitHub the websites live in the SITES_JSON secret. On your PC, point to a local file
# (copy sites.example.json to sites.json and edit it; sites.json is ignored by git).
SITES_FILE=sites.json

# Any random text. Used to scramble the site IDs saved in state.json.
STATE_SALT=change-me-to-random-text

# --- Email (primary) --------------------------------------------------------
# Titan Email. Use port 465 (SSL) or 587 (STARTTLS).
# If your Titan is hosted by GoDaddy, use SMTP_HOST=smtpout.secureserver.net instead.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=alerts@your-domain.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=alerts@your-domain.com
# One or more addresses, separated by commas.
EMAIL_TO=you@your-domain.com,partner@your-domain.com

# --- Optional ---------------------------------------------------------------
# Browser name the monitor presents itself as. Update it when browsers move on.
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36

# Email me when content scanning pauses or resumes on a site (default false = stay silent).
NOTIFY_ON_BLOCKED_CHANGE=false

# Set to true to run all checks and print results without sending anything.
DRY_RUN=false

# Healthchecks.io ping URL (dead man's switch). The monitor now runs every 8 hours, so on the
# healthchecks.io dashboard set this check to Period = 8 hours and Grace Time = 2 hours.
HEALTHCHECK_URL=

# Show real client names in logs when testing locally (always hidden on GitHub).
LOG_REAL_NAMES=true

# --- Outside confirmation of DOWN (free) --------------------------------------------------------
# A site is only reported DOWN when other locations around the world, outside GitHub, agree. A failure
# seen only from this monitor is a WARNING ("the monitor may be blocked"), never a DOWN.
# Uses Globalping (https://globalping.io). It needs NO token and NO sign-up.
# Kill switch. false = outside confirmation off, DOWN alerts come from the GitHub runner alone again.
CONFIRM_ENABLED=true
# Pause between the first and the second look at a failing site (seconds).
CONFIRM_WAIT_SECONDS=300
# Optional and free. A token raises Globalping's limit from 250 to 500 tests an hour. Leave empty to use none.
GLOBALPING_TOKEN=
